{
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "requirePragma": false,
  "semi": true,
  "sortPackageJson": false,
  "ignorePatterns": ["build/", "node_modules/", "dist/"],
  "sortImports": {
    "newlinesBetween": false,
    "groups": [
      "type-import",
      ["value-builtin", "value-external"],
      "type-internal",
      "value-internal",
      ["type-parent", "type-sibling", "type-index"],
      ["value-parent", "value-sibling", "value-index"],
      "unknown",
    ],
  },
  "sortTailwindcss": {
    "stylesheet": "./libs/ui/src/index.css",
    "functions": ["clsx", "cn"],
    "preserveWhitespace": true,
  },
}
